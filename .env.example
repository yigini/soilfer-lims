# ─── SoilFER-LIMS Configuration ───
# Copy this file to .env and update the values

# Server port
PORT=3000

# JWT Secret — REQUIRED for production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Environment
NODE_ENV=production

# External HTTPS URL used for generated report links.
BASE_URL=
# Extra browser origins, comma-separated HTTPS origins only. Empty = same-origin.
ALLOWED_ORIGINS=
# Trust only the reverse proxy addresses/subnets that can reach the API.
TRUST_PROXY=loopback
# Public health/version responses omit version and uptime by default.
HEALTH_SHOW_VERSION=false
# API request budgets per 15 minutes. Valid JWTs share a budget by user id.
API_RATE_LIMIT_USER_MAX=3000
# Missing, invalid and expired JWTs use a separate budget per client IP outside exchange API-key requests.
API_RATE_LIMIT_ANON_MAX=300
# API keys on /api/v2/data-exchange and /api/v2/sis use their own per-IP budget.
API_RATE_LIMIT_EXCHANGE_MAX=1000

# Deployment Mode
#   local  = Single laboratory, LAB_MANAGER admin (default)
#   global = Multi-laboratory network, SUPER_ADMIN
DEPLOYMENT_MODE=local
