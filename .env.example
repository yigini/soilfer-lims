# ─── SoilFER-LIMS Configuration ───
# Copy this file to .env and update the values

# Server port
PORT=3000

# JWT Secret — REQUIRED for production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Environment
NODE_ENV=production

# Extra browser origins, comma-separated HTTPS origins only. Empty = same-origin.
ALLOWED_ORIGINS=
# Trust only the reverse proxy addresses/subnets that can reach the API.
TRUST_PROXY=loopback
# Public health/version responses omit version and uptime by default.
HEALTH_SHOW_VERSION=false

# Deployment Mode
#   local  = Single laboratory, LAB_MANAGER admin (default)
#   global = Multi-laboratory network, SUPER_ADMIN
DEPLOYMENT_MODE=local
