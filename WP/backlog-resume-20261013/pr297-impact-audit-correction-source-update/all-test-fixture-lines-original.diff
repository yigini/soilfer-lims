+        const input = { analyses: [' Particle Size Analysis ', 'TEXTURE', 'exchangeableBases'], reason: '  Client revised the order  ' };
+        const before = JSON.stringify(input);
+        expect(orderRevisionRequest(input, facts)).toEqual({ analyses: ['TEXTURE', 'EXCH_CA', 'EXCH_MG', 'EXCH_K', 'EXCH_NA'],
+            reason: 'Client revised the order', changed: true, explicitTarget: true });
+        expect(JSON.stringify(input)).toBe(before);
+    });
+    test('equivalent normalised sets are a no-op without an invented reason', () => {
+        expect(orderRevisionRequest({ analyses: ['TEXTURE', 'PH_H2O'] },
+            { currentAnalyses: ['PH_H2O', 'pSA'], priorActiveCount: 1 })).toMatchObject({ changed: false, reason: null });
+    });
+    test('three historical ACTIVE revisions require an explicit complete set', () => {
+        errorCode(() => orderRevisionRequest({ reason: 'Reviewed all orders' }, { ...facts, priorActiveCount: 3 }),
+            'ORDER_TARGET_REQUIRED', 409);
+    });
+    test('an unchanged target still needs a deliberate reason when repairing ACTIVE ambiguity', () => {
+        errorCode(() => orderRevisionRequest({ analyses: ['PH_H2O'] }, { ...facts, priorActiveCount: 3 }),
+            'TRANSITION_REASON_REQUIRED', 400);
+        expect(orderRevisionRequest({ analyses: ['PH_H2O'], reason: 'Reviewed all prior revisions' },
+            { ...facts, priorActiveCount: 3 })).toMatchObject({ changed: true, explicitTarget: true });
+    });
+    test('a complete empty set is a reasoned request, leaving downstream reconciliation to protect recorded work', () => {
+        expect(orderRevisionRequest({ analyses: [], reason: 'No remaining requested analyses' }, facts)).toMatchObject({ analyses: [], changed: true });
+    });
+    test('a reasoned line repair cannot disappear as an unchanged-analysis no-op', () => {
+        errorCode(() => orderRevisionRequest({ analyses: ['PH_H2O'] }, { ...facts, requiresLineRevision: true }),
+            'TRANSITION_REASON_REQUIRED', 400);
+        expect(orderRevisionRequest({ analyses: ['PH_H2O'], reason: 'Resolve missing order line' },
+            { ...facts, requiresLineRevision: true })).toMatchObject({ changed: true });
+    });
+    test.each(['PH_H2O', [''], ['  '], [null], [42]])('refuses malformed requested selections %p', analyses => {
+        errorCode(() => orderRevisionRequest({ analyses, reason: 'Changed order' }, facts), 'INVALID_ANALYSIS_SELECTION', 400);
+    });
+    test('corrupt stored selections cannot be silently replaced', () => {
+        errorCode(() => orderRevisionRequest({ analyses: ['PH_H2O'], reason: 'Changed order' },
+            { currentAnalyses: null, priorActiveCount: 1 }), 'INVALID_STORED_ANALYSES', 409);
+    });
+});
diff --git a/server/tests/contracts/issue_209_order_revision_ui.test.js b/server/tests/contracts/issue_209_order_revision_ui.test.js
new file mode 100644
index 00000000..96174a97
--- /dev/null
+++ b/server/tests/contracts/issue_209_order_revision_ui.test.js
@@ -0,0 +1,35 @@
+const fs = require('node:fs'), path = require('node:path');
+const { mountUi } = require('../helpers/qcWorksheetUi');
+function mount(status = 'PROCESSING') {
+    const axios = { get: jest.fn(async () => ({ data: [] })), post: jest.fn(async () => ({ data: {} })), put: jest.fn(async () => ({ data: {} })) };
+    return mountUi('components/sample/AnalysisUpdateModal.jsx', { sample: { id: 'owned-order-ui', status, requiredAnalyses: ['PH_H2O'] },
+        isOpen: true, onClose: jest.fn(), onUpdateSuccess: jest.fn() }, { axios });
+}
+const save = view => view.all().find(node => node.type === 'button' && String(view.text()).includes('Save Changes') && node.props.onClick?.name === 'handleSave');
+const reason = view => view.all().find(node => node.type === 'input' && node.props.id === 'order-revision-reason');
+
+test('the actual analysis dialog requires a reason and sends the full selection with that reason', async () => {
+    const view = mount(); await view.render();
+    expect(reason(view).props.required).toBe(true); expect(save(view).props.disabled).toBe(true);
+    await save(view).props.onClick(); await view.render(); expect(view.axios.put).not.toHaveBeenCalled();
+    expect(view.text()).toContain('orderRevision.reasonRequired');
+    reason(view).props.onChange({ target: { value: ' Reviewed full order ' } }); await view.render();
+    expect(save(view).props.disabled).toBe(false); await save(view).props.onClick();
+    expect(view.axios.put).toHaveBeenCalledWith('/api/samples/owned-order-ui/analyses',
+        expect.objectContaining({ analyses: ['PH_H2O'], reason: 'Reviewed full order' }), expect.any(Object));
+    view.unmount();
+});
+
+test.each(['APPROVED', 'ARCHIVED', 'DISPOSED'])('the actual %s dialog guides amendment and disables direct order changes', async status => {
+    const view = mount(status); await view.render();
+    reason(view).props.onChange({ target: { value: 'Reviewed request' } }); await view.render();
+    expect(save(view).props.disabled).toBe(true); expect(view.text()).toContain('orderRevision.amendmentRequired');
+    expect(view.axios.put).not.toHaveBeenCalled(); view.unmount();
+});
+
+test.each(['en','es','es-419','fr','pt'])('order-revision messages exist in both %s catalogues', locale => {
+    for (const directory of ['client/src/translations', 'server/locales']) {
+        const messages = JSON.parse(fs.readFileSync(path.resolve(__dirname, '../../..', directory, locale + '.json'), 'utf8')).orderRevision;
+        for (const key of ['reason','reasonPlaceholder','reasonRequired','completeTarget','amendmentRequired']) expect(messages[key].trim()).not.toBe('');
+    }
+});
