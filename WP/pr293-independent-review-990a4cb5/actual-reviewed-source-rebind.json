    "title": "[Audit 6.4] Exports use the selected reported value",
    "user": {
      "login": "yigini",
      "id": 32960535,
      "node_id": "MDQ6VXNlcjMyOTYwNTM1",
      "avatar_url": "https://avatars.githubusercontent.com/u/32960535?v=4",
