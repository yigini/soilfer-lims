      "gists_url": "https://api.github.com/users/yigini/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/yigini/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/yigini/subscriptions",
      "organizations_url": "https://api.github.com/users/yigini/orgs",
      "repos_url": "https://api.github.com/users/yigini/repos",
